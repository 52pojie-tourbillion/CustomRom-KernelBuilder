# Minimal DroidSpaces GKI config for ZTE P875A02 (kernel 5.4)
# Only the mandatory options; no USER_NS/netfilter extras to keep vendor modules safe.

CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_DEVTMPFS=y

# Fixed kernel release so stock vendor modules keep loading
CONFIG_LOCALVERSION="-qgki-ge901dadb8c32"
# CONFIG_LOCALVERSION_AUTO is not set
