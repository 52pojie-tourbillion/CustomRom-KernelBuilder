+/*
+ * Battery charge limit: stop at batt_limit_stop percent, resume 5% below.
+ * Uses the charger's CHG_DISABLE votable (the same switch as JEITA), so the
+ * limit is enforced by the charger hardware and survives userspace changes.
+ */
+#define BATT_LIMIT_HYSTERESIS	5
+#define BATT_LIMIT_VOTER	"BATT_LIMIT_VOTER"
+
+static int batt_limit_stop = 80;
+module_param(batt_limit_stop, int, 0644);
+MODULE_PARM_DESC(batt_limit_stop, "Stop charging at this capacity percentage, 0 disables");
+
+static bool batt_limit_active;
+
+static void smblib_batt_limit_check(struct smb_charger *chg)
+{
+	union power_supply_propval val = { 0 };
+	int stop, resume, rc;
+
+	if (!chg->chg_disable_votable)
+		return;
+
+	stop = batt_limit_stop;
+	if (stop <= 0 || stop > 100) {
+		if (batt_limit_active) {
+			batt_limit_active = false;
+			vote(chg->chg_disable_votable, BATT_LIMIT_VOTER, false, 0);
+			pr_info("batt_limit: disabled, charging released\n");
+		}
+		return;
+	}
+	resume = stop - BATT_LIMIT_HYSTERESIS;
+
+	rc = smblib_get_prop_batt_capacity(chg, &val);
+	if (rc < 0)
+		return;
+
+	if (val.intval >= stop) {
+		if (!batt_limit_active) {
+			batt_limit_active = true;
+			vote(chg->chg_disable_votable, BATT_LIMIT_VOTER, true, 0);
+			pr_info("batt_limit: %d%%, charging stopped at %d%%\n",
+				val.intval, stop);
+		}
+	} else if (val.intval <= resume) {
+		if (batt_limit_active) {
+			batt_limit_active = false;
+			vote(chg->chg_disable_votable, BATT_LIMIT_VOTER, false, 0);
+			pr_info("batt_limit: %d%%, charging resumed (stop %d%%)\n",
+				val.intval, stop);
+		}
+	}
+}
