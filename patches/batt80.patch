+/*
+ * Battery charge limit: stop at batt_limit_stop percent, resume 5% below.
+ *
+ * The vendor charger policy re-enables charging from userspace every few
+ * seconds (it writes the class attributes below).  Coerce those enable
+ * paths and re-check on every battery property update so the limit is
+ * enforced by the driver/firmware and cannot be overridden from userspace.
+ */
+static int batt_limit_stop = 80;
+module_param(batt_limit_stop, int, 0644);
+MODULE_PARM_DESC(batt_limit_stop, "Stop charging at this capacity percentage, 0 disables");
+
+static bool batt_limit_active;
+
+static int batt_limit_soc(struct battery_chg_dev *bcdev)
+{
+	int cap;
+
+	if (!bcdev)
+		return -1;
+
+	cap = bcdev->psy_list[PSY_TYPE_BATTERY].prop[BATT_CAPACITY];
+	if (cap <= 0)
+		return -1;
+
+	return cap / 100;
+}
+
+static void batt_limit_apply(struct battery_chg_dev *bcdev, bool stop)
+{
+	usb_psy_set_icl(bcdev, USB_INPUT_CURR_LIMIT, stop ? 49000 : 0xFFFFFFFF);
+	write_property_id(bcdev, &bcdev->psy_list[PSY_TYPE_BATTERY],
+			  BATT_FCC_USER, stop ? 0 : 0xFFFFFFFF);
+}
+
+static void batt_limit_check(struct battery_chg_dev *bcdev)
+{
+	int cap, stop = batt_limit_stop;
+
+	if (!bcdev)
+		return;
+
+	if (stop <= 0 || stop > 100) {
+		if (batt_limit_active) {
+			batt_limit_active = false;
+			batt_limit_apply(bcdev, false);
+			pr_info("batt_limit: disabled, charging released\n");
+		}
+		return;
+	}
+
+	cap = batt_limit_soc(bcdev);
+	if (cap < 0)
+		return;
+
+	if (cap >= stop) {
+		if (!batt_limit_active) {
+			batt_limit_active = true;
+			batt_limit_apply(bcdev, true);
+			pr_info("batt_limit: %d%%, charging stopped (limit %d%%)\n",
+				cap, stop);
+		}
+	} else if (cap <= stop - 5 && batt_limit_active) {
+		batt_limit_active = false;
+		batt_limit_apply(bcdev, false);
+		pr_info("batt_limit: %d%%, charging resumed\n", cap);
+	}
+}
