+/*
+ * Battery charge limit (two phase):
+ *   capacity > stop+1 : throttle USB input to 49mA and FCC=0 -> the battery
+ *                       drains down to the limit while the phone keeps
+ *                       running (it is powered from the battery for a while).
+ *   capacity <= stop+1: FCC=0, input normal -> the battery idles at the
+ *                       limit and the phone runs from the charger.  No
+ *                       75-80 cycling.
+ *   capacity <= stop-5: release both -> charge again after real use.
+ *
+ * The vendor charger policy re-enables charging from userspace every few
+ * seconds (it writes the class attributes below).  The stores coerce those
+ * writes while the limit is active, so userspace cannot override the limit.
+ */
+#define BATT_LIMIT_HYSTERESIS	5
+static int batt_limit_stop = 80;
+module_param(batt_limit_stop, int, 0644);
+MODULE_PARM_DESC(batt_limit_stop, "Stop charging at this capacity percentage, 0 disables");
+
+static bool batt_limit_active;
+static bool batt_limit_draining;
+
+static int batt_limit_soc(struct battery_chg_dev *bcdev)
+{
+	int cap;
+
+	if (!bcdev)
+		return -1;
+
+	cap = bcdev->psy_list[PSY_TYPE_BATTERY].prop[BATT_CAPACITY];
+	if (cap <= 0)
+		return -1;
+
+	return cap / 100;
+}
+
+static void batt_limit_apply(struct battery_chg_dev *bcdev, bool stop, bool drain)
+{
+	if (!stop) {
+		usb_psy_set_icl(bcdev, USB_INPUT_CURR_LIMIT, 0xFFFFFFFF);
+		write_property_id(bcdev, &bcdev->psy_list[PSY_TYPE_BATTERY],
+				  BATT_FCC_USER, 0xFFFFFFFF);
+		return;
+	}
+
+	usb_psy_set_icl(bcdev, USB_INPUT_CURR_LIMIT,
+			drain ? 49000 : 0xFFFFFFFF);
+	write_property_id(bcdev, &bcdev->psy_list[PSY_TYPE_BATTERY],
+			  BATT_FCC_USER, 0);
+}
+
+static void batt_limit_check(struct battery_chg_dev *bcdev)
+{
+	int cap, stop = batt_limit_stop;
+
+	if (!bcdev)
+		return;
+
+	if (stop <= 0 || stop > 100) {
+		if (batt_limit_active) {
+			batt_limit_active = false;
+			batt_limit_draining = false;
+			batt_limit_apply(bcdev, false, false);
+			pr_info("batt_limit: disabled, charging released\n");
+		}
+		return;
+	}
+
+	cap = batt_limit_soc(bcdev);
+	if (cap < 0)
+		return;
+
+	if (cap > stop + 1) {
+		if (!batt_limit_draining) {
+			batt_limit_active = true;
+			batt_limit_draining = true;
+			batt_limit_apply(bcdev, true, true);
+			pr_info("batt_limit: %d%%, draining to %d%%\n", cap, stop);
+		}
+	} else if (cap > stop - BATT_LIMIT_HYSTERESIS) {
+		if (batt_limit_draining || !batt_limit_active) {
+			batt_limit_active = true;
+			batt_limit_draining = false;
+			batt_limit_apply(bcdev, true, false);
+			pr_info("batt_limit: %d%%, holding at %d%%\n", cap, stop);
+		}
+	} else if (batt_limit_active) {
+		batt_limit_active = false;
+		batt_limit_draining = false;
+		batt_limit_apply(bcdev, false, false);
+		pr_info("batt_limit: %d%%, charging resumed\n", cap);
+	}
+}
+
+static struct delayed_work batt_limit_work;
+static struct battery_chg_dev *batt_limit_dev;
+
+static void batt_limit_work_fn(struct work_struct *work)
+{
+	struct battery_chg_dev *bcdev = batt_limit_dev;
+
+	if (bcdev) {
+		read_property_id(bcdev, &bcdev->psy_list[PSY_TYPE_BATTERY],
+				 BATT_CAPACITY);
+		batt_limit_check(bcdev);
+	}
+
+	schedule_delayed_work(&batt_limit_work, msecs_to_jiffies(15000));
+}
